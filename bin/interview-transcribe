#!/usr/bin/env bash
# interview-transcribe — TUI front-end for the WhisperX + Obsidian pipeline.
set -euo pipefail

for tool in gum transcribe-interview flatpak; do
    if ! command -v "$tool" &>/dev/null; then
        echo "missing: $tool" >&2; exit 1
    fi
done
if [[ -z "${HF_TOKEN:-}" ]]; then
    gum style --foreground 196 --bold \
        "HF_TOKEN is not set. Add it to ~/.zshrc and restart your shell."
    exit 1
fi

clear
gum style \
    --border double --margin "1 2" --padding "1 4" \
    --border-foreground 33 --foreground 33 --bold \
    "interview-transcribe" \
    "WhisperX + Obsidian, local + private"

gum format -- "**Step 1 of 4.** Pick the audio file."
AUDIO=$(gum file "${HOME}/Downloads")
[[ -z "$AUDIO" ]] && { gum style --foreground 196 "No file chosen."; exit 1; }
gum style --foreground 244 "  -> $AUDIO"
echo

gum format -- "**Step 2 of 4.** Who is this interview with?"
STAKEHOLDER=$(gum input --placeholder "e.g. Jane Doe" --width 50)
[[ -z "$STAKEHOLDER" ]] && STAKEHOLDER="unknown"
gum style --foreground 244 "  -> $STAKEHOLDER"
echo

gum format -- "**Step 3 of 4.** Model size."
MODEL_LABEL=$(gum choose --header "Best quality first; lower if you hit OOM:" \
    "large-v3   (best quality, 8 GB+ VRAM)" \
    "large-v2   (good quality, 6 GB VRAM)" \
    "medium     (acceptable, 4 GB VRAM)" \
    "small      (fastest, 2 GB VRAM)")
MODEL=$(echo "$MODEL_LABEL" | awk '{print $1}')
gum style --foreground 244 "  -> $MODEL"
echo

gum format -- "**Step 4 of 4.** Ready."
gum style --foreground 244 \
    "  File:        $(basename "$AUDIO")" \
    "  Stakeholder: $STAKEHOLDER" \
    "  Model:       $MODEL"
gum confirm "Transcribe now?" || { gum style --foreground 196 "Aborted."; exit 0; }
echo

DURATION=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$AUDIO" 2>/dev/null \
    | awk '{printf "%.2f", $1}')
[[ -z "$DURATION" ]] && DURATION=0

LOG=$(mktemp)
transcribe-interview "$AUDIO" "$STAKEHOLDER" "$MODEL" > "$LOG" 2>&1 &
ENGINE_PID=$!
# Make sure the engine doesn't outlive the TUI if we crash or get Ctrl-C'd.
trap 'kill "$ENGINE_PID" 2>/dev/null || true; wait "$ENGINE_PID" 2>/dev/null || true; rm -f "$LOG"' EXIT

# Phase weights: VAD 5%, transcribe 70%, align 10%, diarize 15%.
# During transcribe, scale by latest segment end-time / total duration.
STAGE="Loading models"
PERCENT=2

render_bar() {
    local pct=$1
    local width=40
    local filled=$(( pct * width / 100 ))
    local empty=$(( width - filled ))
    printf "  %3d%% [" "$pct"
    printf "%${filled}s" '' | tr ' ' '#'
    printf "%${empty}s" '' | tr ' ' '-'
    printf "]  %s" "$2"
}

print_status() {
    printf "\r\033[K"
    render_bar "$PERCENT" "$STAGE"
}

print_status
while kill -0 "$ENGINE_PID" 2>/dev/null; do
    if [[ -s "$LOG" ]]; then
        if grep -q "Performing diarization" "$LOG"; then
            STAGE="Diarizing speakers"
            PERCENT=90
        elif grep -q "Performing alignment" "$LOG"; then
            STAGE="Aligning timestamps"
            PERCENT=82
        elif grep -q "Performing transcription" "$LOG"; then
            STAGE="Transcribing"
            # Tolerate "no segments yet": empty match must not trip pipefail+set -e
            LAST_END=$( { grep -oE 'Transcript: \[[0-9.]+ --> [0-9.]+\]' "$LOG" 2>/dev/null \
                | tail -1 | awk -F'-->' '{print $2}' | tr -d ' []'; } || true )
            if [[ -n "$LAST_END" && $(echo "$DURATION > 0" | bc -l) -eq 1 ]]; then
                PERCENT=$(awk -v end="$LAST_END" -v dur="$DURATION" \
                    'BEGIN { printf "%d", 10 + (end/dur)*70 }')
                (( PERCENT > 80 )) && PERCENT=80
            else
                PERCENT=12
            fi
        elif grep -q "Performing voice activity" "$LOG"; then
            STAGE="Detecting voice activity"
            PERCENT=5
        fi
    fi
    print_status
    sleep 0.5
done

ENGINE_EXIT=0
wait "$ENGINE_PID" || ENGINE_EXIT=$?

PERCENT=100
STAGE="Done"
print_status
echo
echo

if [[ $ENGINE_EXIT -eq 0 ]]; then
    NOTE=$(tail -n 1 "$LOG")
    gum style \
        --border rounded --margin "1 2" --padding "1 2" \
        --border-foreground 46 --foreground 46 \
        "Transcription complete." \
        "" \
        "Note: $NOTE"
    if gum confirm "Open in Obsidian now?"; then
        flatpak run md.obsidian.Obsidian "$NOTE" &>/dev/null &
    fi
else
    gum style --foreground 196 --bold "Transcription failed. Last lines of log:"
    tail -n 20 "$LOG"
    exit 1
fi
