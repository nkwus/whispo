#!/usr/bin/env bash
# Engine — called by the whispo TUI or directly.
# Usage:  transcribe-interview <audio-file> [model]
#
# Stakeholder is no longer a concept — the note is keyed off the audio
# filename, and people in the recording are tracked as speakers (see the
# rename flow in the UI).
set -euo pipefail

if [[ $# -lt 1 ]]; then
    echo "usage: transcribe-interview <audio-file> [model]" >&2
    exit 1
fi

AUDIO="$1"
MODEL="${2:-large-v3}"
DATE=$(date +%Y-%m-%d)

# Note + transcript filenames mirror the audio filename (minus extension)
# so each recording maps to a single, easy-to-find output.
BASE=$(basename "${AUDIO%.*}")

# Raw outputs sit outside the vault; templated notes go inside it.
RAW="${HOME}/Documents/whispo"
VAULT="${RAW}/whispo_vault"
OUT_DIR="${RAW}/transcripts"
NOTE_DIR="${VAULT}/notes"
NOTE="${NOTE_DIR}/${BASE}.md"
WORK_DIR=$(mktemp -d)
TEMPLATE="${VAULT}/templates/Interview.md"

mkdir -p "${OUT_DIR}" "${NOTE_DIR}"

# Derive a human-friendly title from the audio filename: strip date prefixes
# and recorder tags, replace separators with spaces, title-case.
TITLE=$(python3 - "${AUDIO}" <<'PY'
import re, sys
from pathlib import Path
stem = Path(sys.argv[1]).stem
if not stem or stem.startswith("."):
    print(stem)
else:
    stem = re.sub(
        r"^(?:\d{4}[-_./]?\d{2}[-_./]?\d{2}|\d{2}[-_./]\d{2}[-_./]\d{2,4})[-_.\s]+",
        "", stem,
    )
    stem = re.sub(
        r"[-_.\s]+(?:recording|zoom|meet|teams|interview|raw|edited|copy|final)\b.*$",
        "", stem, flags=re.IGNORECASE,
    )
    cleaned = re.sub(r"[-_.]+", " ", stem).strip()
    print(cleaned.title() if cleaned else Path(sys.argv[1]).stem.title())
PY
)

# Free GPU memory held by the summary model before whisperx loads its own ~5.5 GB.
OLLAMA_MODEL="${OLLAMA_MODEL:-mistral:latest}"
if command -v curl &>/dev/null; then
    curl -sS --max-time 5 \
        http://localhost:11434/api/generate \
        -d "{\"model\":\"${OLLAMA_MODEL}\",\"keep_alive\":0}" \
        > /dev/null 2>&1 || true
fi

# shellcheck disable=SC1091
source "${HOME}/.venvs/whisperx/bin/activate"

# Force unbuffered output so the TUI progress bar sees segments as they're emitted.
export PYTHONUNBUFFERED=1

whisperx "${AUDIO}" \
    --model "${MODEL}" \
    --diarize \
    --hf_token "${HF_TOKEN:?HF_TOKEN not set}" \
    --output_dir "${WORK_DIR}" \
    --output_format txt \
    --language en \
    --compute_type float16

TXT="${WORK_DIR}/${BASE}.txt"

cp "${TXT}" "${OUT_DIR}/${BASE}.txt"

sed -e "s|{{title}}|${TITLE}|g" \
    -e "s|{{date}}|${DATE}|g" "${TEMPLATE}" > "${NOTE}"
echo "" >> "${NOTE}"
cat "${TXT}" >> "${NOTE}"

# Optional local summary via Ollama. Skips silently if ollama isn't installed
# or the model isn't pulled, so the engine still succeeds without it.
if command -v ollama &>/dev/null && ollama list 2>/dev/null | grep -q "^${OLLAMA_MODEL%%:*}"; then
    echo "Performing summary using ${OLLAMA_MODEL}..." >&2
    python3 - "${OLLAMA_MODEL}" "${TXT}" "${NOTE}" <<'PY' || true
import json, sys, urllib.request, pathlib

model, txt_path, note_path = sys.argv[1], pathlib.Path(sys.argv[2]), pathlib.Path(sys.argv[3])
transcript = txt_path.read_text()

prompt = (
    "Summarize this conversation transcript. Output ONLY valid JSON matching this schema:\n"
    "{\n"
    '  "summary": "three-sentence summary of the conversation",\n'
    '  "key_claims": ["SPEAKER_NN: claim text", ...up to 5...],\n'
    '  "action_items": ["explicit action item", ...]\n'
    "}\n"
    "Use empty lists if a section has nothing. Speaker labels look like SPEAKER_00, SPEAKER_01.\n\n"
    "Transcript:\n" + transcript
)

req = urllib.request.Request(
    "http://localhost:11434/api/generate",
    data=json.dumps({
        "model": model,
        "prompt": prompt,
        "format": "json",
        "stream": False,
        "keep_alive": 0,
    }).encode(),
    headers={"Content-Type": "application/json"},
)
try:
    resp = json.loads(urllib.request.urlopen(req, timeout=300).read())
    data = json.loads(resp.get("response", "{}"))
except Exception:
    sys.exit(0)

text = note_path.read_text()
if data.get("summary"):
    text = text.replace("## Summary\n\n\n",
                        f"## Summary\n\n{data['summary']}\n\n", 1)
if data.get("key_claims"):
    bullets = "\n".join(f"- {c}" for c in data["key_claims"])
    text = text.replace("## Key claims\n\n\n",
                        f"## Key claims\n\n{bullets}\n\n", 1)
if data.get("action_items"):
    bullets = "\n".join(f"- {i}" for i in data["action_items"])
    text = text.replace("## Action items\n\n\n",
                        f"## Action items\n\n{bullets}\n\n", 1)
note_path.write_text(text)
PY
fi

echo "${NOTE}"
