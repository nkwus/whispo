#!/usr/bin/env bash
# Engine — called by interview-transcribe TUI or directly.
# Usage:  transcribe-interview <audio-file> <stakeholder> [model]
set -euo pipefail

if [[ $# -lt 2 ]]; then
    echo "usage: transcribe-interview <audio-file> <stakeholder> [model]" >&2
    exit 1
fi

AUDIO="$1"
STAKEHOLDER="$2"
MODEL="${3:-large-v3}"
DATE=$(date +%Y-%m-%d)
SLUG=$(echo "${STAKEHOLDER}" | tr '[:upper:] ' '[:lower:]-')
OUT_DIR="${HOME}/Documents/whisperx/Transcripts"
NOTE_DIR="${HOME}/Documents/whisperx/Interviews"
NOTE="${NOTE_DIR}/${DATE}-${SLUG}.md"
WORK_DIR=$(mktemp -d)
TEMPLATE="${HOME}/Documents/whisperx/Templates/Interview.md"

mkdir -p "${OUT_DIR}" "${NOTE_DIR}"

# shellcheck disable=SC1091
source "${HOME}/.venvs/whisperx/bin/activate"

# Force unbuffered output so the TUI progress bar sees segments as they're emitted.
export PYTHONUNBUFFERED=1

whisperx "${AUDIO}" \
    --model "${MODEL}" \
    --diarize \
    --hf_token "${HF_TOKEN:?HF_TOKEN not set}" \
    --output_dir "${WORK_DIR}" \
    --output_format txt \
    --language en \
    --compute_type float16

BASE=$(basename "${AUDIO%.*}")
TXT="${WORK_DIR}/${BASE}.txt"

cp "${TXT}" "${OUT_DIR}/${DATE}-${SLUG}.txt"

sed -e "s/{{stakeholder}}/${STAKEHOLDER}/g" \
    -e "s/{{date}}/${DATE}/g" "${TEMPLATE}" > "${NOTE}"
echo "" >> "${NOTE}"
cat "${TXT}" >> "${NOTE}"

# Optional local summary via Ollama. Skips silently if ollama isn't installed
# or the model isn't pulled, so the engine still succeeds without it.
OLLAMA_MODEL="${OLLAMA_MODEL:-mistral:latest}"
if command -v ollama &>/dev/null && ollama list 2>/dev/null | grep -q "^${OLLAMA_MODEL%%:*}"; then
    PROMPT="You are summarizing a stakeholder interview transcript. "
    PROMPT+="Produce: (1) a three-sentence summary, (2) up to 5 key claims with "
    PROMPT+="the speaker label, (3) any explicit action items. Be concise. Transcript:"

    SUMMARY_FILE=$(mktemp)
    # TERM=dumb tells Ollama to skip its streaming pretty-printer; we still
    # strip any residual ANSI escapes (ESC[…m, ESC[…D, ESC[K, etc.).
    TERM=dumb ollama run "${OLLAMA_MODEL}" "${PROMPT}"$'\n\n'"$(cat "${TXT}")" 2>/dev/null \
        | sed -E 's/\x1b\[[0-9;?]*[A-Za-z]//g' > "${SUMMARY_FILE}" || true

    if [[ -s "${SUMMARY_FILE}" ]]; then
        python3 - "${NOTE}" "${SUMMARY_FILE}" <<'PY'
import sys, pathlib
note = pathlib.Path(sys.argv[1])
summary = pathlib.Path(sys.argv[2]).read_text().strip()
text = note.read_text()
text = text.replace("## Summary\n\n\n", f"## Summary\n\n{summary}\n\n", 1)
note.write_text(text)
PY
    fi
    rm -f "${SUMMARY_FILE}"
fi

echo "${NOTE}"
